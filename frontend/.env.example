# Copia este archivo como .env:
#   cp .env.example .env
#
# Este archivo SÍ se sube a git. El .env NO.
#
# Vite solo expone al navegador las variables que empiezan con VITE_.

# ---------------------------------------------------------------------------
# Dirección del backend
# ---------------------------------------------------------------------------

# Para trabajar en tu computadora, así está bien:
VITE_API_URL="http://localhost:3000"

# Para probar desde el CELULAR (por ejemplo al escanear un QR de inscripción),
# "localhost" no sirve: en el teléfono significa el teléfono mismo. Hay que
# poner la IP de tu computadora en la red local.
#
# Para averiguarla:
#   macOS   ipconfig getifaddr en0
#   Linux   hostname -I
#   Windows ipconfig   (busca "Dirección IPv4")
#
# Y luego, en los dos archivos .env:
#
#   frontend/.env   VITE_API_URL="http://192.168.1.77:3000"
#   backend/.env    PUBLIC_APP_URL="http://192.168.1.77:5173"
#                   CORS_ORIGIN="http://localhost:5173,http://192.168.1.77:5173"
#
# El celular y la computadora tienen que estar en la MISMA red wifi.
# VITE_API_URL="http://192.168.1.77:3000"
