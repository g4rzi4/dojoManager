  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Full-width form submit; the violet primary action with its inner edge.",
      "html": "<button class=\"ds-btn-primary\">Iniciar sesión</button>",
      "css": ".ds-btn-primary { width: 100%; cursor: pointer; border: none; border-radius: 20px; background: var(--color-violet-600); color: var(--color-violet-50); padding: 14px 16px; font-size: 1.125rem; font-weight: 600; font-family: inherit; box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12), inset 0 1.5px 0 rgb(255 255 255 / 0.3), 0 8px 18px -10px rgb(127 34 254 / 0.8); transition: background-color 200ms, transform 200ms; } .ds-btn-primary:hover { background: var(--color-violet-700); } .ds-btn-primary:active { transform: scale(0.98); } .ds-btn-primary:focus-visible { outline: none; box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--color-violet-600); }"
    },
    {
      "name": "Compact Primary Button",
      "kind": "button",
      "refersTo": "button-compact",
      "description": "On-screen primary action, with an optional leading icon.",
      "html": "<button class=\"ds-btn-compact\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 17V7\"/><path d=\"M16 8h-6a2 2 0 0 0 0 4h4a2 2 0 0 1 0 4H8\"/><path d=\"M4 3a1 1 0 0 1 1-1 1.3 1.3 0 0 1 .7.2l.933.6a1.3 1.3 0 0 0 1.4 0l.934-.6a1.3 1.3 0 0 1 1.4 0l.933.6a1.3 1.3 0 0 0 1.4 0l.933-.6a1.3 1.3 0 0 1 1.4 0l.934.6a1.3 1.3 0 0 0 1.4 0l.933-.6A1.3 1.3 0 0 1 19 2a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1 1.3 1.3 0 0 1-.7-.2l-.933-.6a1.3 1.3 0 0 0-1.4 0l-.934.6a1.3 1.3 0 0 1-1.4 0l-.933-.6a1.3 1.3 0 0 0-1.4 0l-.933.6a1.3 1.3 0 0 1-1.4 0l-.934-.6a1.3 1.3 0 0 0-1.4 0l-.933.6a1.3 1.3 0 0 1-.7.2 1 1 0 0 1-1-1z\"/></svg>Pagar</button>",
      "css": ".ds-btn-compact { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; cursor: pointer; border: none; border-radius: 16px; background: var(--color-violet-600); color: #fff; padding: 10px 16px; font-size: 0.875rem; font-weight: 600; font-family: inherit; box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12), inset 0 1.5px 0 rgb(255 255 255 / 0.3), 0 8px 18px -10px rgb(127 34 254 / 0.8); transition: background-color 200ms; } .ds-btn-compact:hover { background: var(--color-violet-700); } .ds-btn-compact:focus-visible { outline: none; box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--color-violet-600); }"
    },
