generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // El backend es CommonJS ("type": "commonjs" en package.json), así que el
  // cliente debe generarse en CJS. Sin esto, Prisma 7 lo genera en ESM y los
  // imports fallan en tiempo de ejecución.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Usuarios y roles
// ---------------------------------------------------------------------------

enum Role {
  /// Dueño del dojo. Único que puede administrar profesores y configuración.
  ADMIN
  /// Subadministrador: alumnos, eventos, pagos y reportes.
  PROFESOR
  /// Madre, padre o tutor. Consulta los expedientes de los alumnos a su cargo.
  TUTOR
  /// Solo consulta su propia tarjeta. No edita nada.
  ALUMNO
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  /// Hash de bcrypt, nunca la contraseña en texto plano.
  password  String
  role      Role     @default(ALUMNO)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Clave única del profesor, p. ej. "PROF-7K2M".
  ///
  /// Solo la tienen los PROFESOR. Se escribe al registrar a un alumno para
  /// ligarlo a ese profesor, así que funciona como identificador y como
  /// código de registro a la vez.
  ///
  /// Es nullable porque admin, tutores y alumnos no tienen clave; el índice
  /// único no estorba porque en Postgres los NULL no colisionan.
  teacherCode String? @unique

  // --- Ficha del profesor ---
  //
  // Van en User y no en una tabla aparte, igual que teacherCode: son pocos
  // campos y siempre se consultan junto con la cuenta. Si la ficha crece
  // mucho, convendría moverlos a un TeacherProfile como se hizo con Student.
  //
  // Todos son nullable porque admin, tutores y alumnos no los usan.

  /// Teléfono de contacto del profesor.
  phone String?

  /// Fecha en que entró a trabajar al dojo.
  hiredAt DateTime? @db.Date

  /// Grado del profesor. Un sensei también tiene su cinta.
  belt Belt?

  /// Especialidad o disciplinas que imparte, en texto libre.
  specialty String?

  /// Notas del administrador sobre el profesor. Solo las ve el admin.
  adminNotes String?

  /// Expediente, solo si este usuario es un alumno.
  student Student?

  /// Alumnos a cargo de este usuario, si es TUTOR.
  guardianOf StudentGuardian[]

  /// Alumnos de los que es profesor responsable, si es PROFESOR.
  studentsTaught Student[] @relation("AlumnoDeProfesor")

  /// Invitaciones de inscripción que ha generado.
  invitationsCreated Invitation[] @relation("InvitacionCreadaPor")

  /// Cobros de eventos acreditados a su clave.
  eventPaymentsCredited  EventEnrollment[]      @relation("CobroAcreditadoA")
  /// Precios que fijó para sus alumnos en cada modalidad.
  modalityPrices         TeacherModalityPrice[] @relation("PrecioDeProfesor")
  /// Cobros de eventos que confirmó.
  eventPaymentsConfirmed EventEnrollment[]      @relation("CobroConfirmadoPor")

  /// Solicitudes de uniformes y protecciones.
  equipmentRequestsMade     EquipmentRequest[] @relation("SolicitudEquipoHechaPor")
  equipmentRequestsAssigned EquipmentRequest[] @relation("SolicitudEquipoProfesor")

  /// Clases del horario que imparte.
  classesTaught DojoClass[] @relation("ClaseDeProfesor")

  /// Enlaces para restablecer su contraseña.
  passwordResetTokens PasswordResetToken[]

  /// Notificaciones que recibe.
  notifications     Notification[] @relation("NotificacionDestinatario")
  /// Avisos que redactó, si es ADMIN o PROFESOR.
  notificationsSent Notification[] @relation("NotificacionAutor")

  // Rastro de quién hizo cada cosa. Son opcionales y con onDelete: SetNull
  // para que dar de baja a un profesor no borre el historial del alumno.
  promotionsEvaluated BeltPromotion[] @relation("PromocionEvaluadaPor")
  notesWritten        StudentNote[]   @relation("NotaEscritaPor")
  attendanceRecorded  Attendance[]    @relation("AsistenciaRegistradaPor")
  paymentsRegistered  Payment[]       @relation("PagoRegistradoPor")
  eventsCreated       Event[]         @relation("EventoCreadoPor")

  @@index([role])
}

// ---------------------------------------------------------------------------
// Alumnos
// ---------------------------------------------------------------------------

/// Enlace de un solo uso para restablecer una contraseña.
///
/// Se guarda el HASH del token, no el token: quien lea esta tabla (un respaldo
/// filtrado, por ejemplo) no puede usar los enlaces vigentes.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum Belt {
  BLANCO
  AMARILLO
  NARANJA
  VERDE
  AZUL
  MARRON
  NEGRO
}

/// Expediente del alumno: los datos de su tarjeta de información.
model Student {
  id        Int       @id @default(autoincrement())
  firstName String
  lastName  String
  birthDate DateTime? @db.Date
  phone     String?

  /// Contacto del tutor como texto suelto, para alumnos cuyo tutor no tiene
  /// cuenta en el sistema. Si la tiene, la relación real es `guardians`.
  guardianName  String?
  guardianPhone String?

  /// Padecimientos, alergias o lesiones que el profesor debe conocer.
  medicalNotes String?

  currentBelt Belt     @default(BLANCO)
  enrolledAt  DateTime @default(now())
  /// Baja lógica: preferimos desactivar antes que borrar, para no perder
  /// el historial de pagos y graduaciones.
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Cuenta para que el alumno entre a ver su propia tarjeta. Opcional:
  /// un alumno puede existir en el sistema sin poder iniciar sesión.
  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Profesor responsable de este alumno.
  ///
  /// Un alumno pertenece a UN solo profesor: es lo que hace que un profesor
  /// vea nada más a sus alumnos. SetNull para que dar de baja a un profesor
  /// deje a sus alumnos sin asignar, en lugar de borrarlos.
  teacherId Int?
  teacher   User? @relation("AlumnoDeProfesor", fields: [teacherId], references: [id], onDelete: SetNull)

  /// Tutores con cuenta que pueden consultar este expediente.
  guardians StudentGuardian[]

  promotions BeltPromotion[]
  attendance Attendance[]
  payments   Payment[]
  notes      StudentNote[]

  /// Invitaciones generadas para sumar tutores a este expediente.
  invitations Invitation[]

  /// Eventos a los que reportó pago o quedó inscrito.
  eventEnrollments EventEnrollment[]

  /// Uniformes y protecciones que se han pedido para él.
  equipmentRequests EquipmentRequest[]

  @@index([lastName, firstName])
  @@index([active])
  @@index([teacherId])
}

enum GuardianRelationship {
  MADRE
  PADRE
  TUTOR
}

/// Relación tutor ↔ alumno.
///
/// Es muchos-a-muchos a propósito: un tutor puede tener varios hijos en el
/// dojo, y un alumno puede tener dos tutores con acceso (por ejemplo, padres
/// separados que ambos quieren consultar el expediente).
///
/// Tabla explícita en lugar de relación implícita, para poder guardar el
/// parentesco y quién es el contacto principal.
model StudentGuardian {
  id Int @id @default(autoincrement())

  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  guardianId Int
  guardian   User @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  relationship GuardianRelationship @default(TUTOR)
  /// A quién llamar primero en una emergencia.
  isPrimary    Boolean              @default(false)

  createdAt DateTime @default(now())

  /// Un tutor no puede estar ligado dos veces al mismo alumno.
  @@unique([studentId, guardianId])
  @@index([guardianId])
}

// ---------------------------------------------------------------------------
// Historial del alumno
// ---------------------------------------------------------------------------

/// Cada cambio de cinta. `Student.currentBelt` es la cinta vigente;
/// esta tabla guarda cómo llegó hasta ahí.
model BeltPromotion {
  id         Int      @id @default(autoincrement())
  studentId  Int
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  belt       Belt
  promotedAt DateTime @db.Date
  notes      String?

  /// Cinta que tenía justo antes. Permite deshacer una graduación capturada
  /// por error sin perder la cinta anterior, que pudo no venir del historial.
  previousBelt Belt?

  evaluatedById Int?
  evaluatedBy   User? @relation("PromocionEvaluadaPor", fields: [evaluatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([studentId, promotedAt])
}

model Attendance {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  present   Boolean  @default(true)

  recordedById Int?
  recordedBy   User? @relation("AsistenciaRegistradaPor", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  /// Una sola marca de asistencia por alumno por día: evita duplicados si
  /// alguien registra la misma clase dos veces.
  @@unique([studentId, date])
  @@index([date])
}

enum PaymentStatus {
  PAGADO
  PENDIENTE
  VENCIDO
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  /// Pendiente de integrar. Ver Payment.externalReference.
  PAYPAL
}

model Payment {
  id        Int     @id @default(autoincrement())
  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Monto en CENTAVOS, como entero. Guardar dinero en float produce errores
  /// de redondeo; usar Decimal complica la serialización a JSON. Para mostrar:
  /// (amountCents / 100).
  amountCents Int

  /// Mes que cubre el pago. Separado de paidAt porque se puede pagar marzo
  /// en abril, y el reporte necesita saber a qué mes corresponde.
  periodYear  Int
  periodMonth Int

  status PaymentStatus @default(PENDIENTE)
  paidAt DateTime?
  note   String?

  /// Cómo se pagó. Nulo mientras está pendiente.
  method PaymentMethod?

  /// Id de la orden de PayPal. Único: una orden liquida un solo cobro, y es
  /// lo que permite conciliar y evitar cobros dobles.
  externalReference String? @unique

  /// La familia dijo que pagó en efectivo o transferencia. No cuenta como
  /// pagado hasta que el admin o el profesor lo confirme.
  reportedMethod PaymentMethod?
  reportedAt     DateTime?

  registeredById Int?
  registeredBy   User? @relation("PagoRegistradoPor", fields: [registeredById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Un cobro por alumno por mes.
  @@unique([studentId, periodYear, periodMonth])
  @@index([status])
}

/// Observaciones del profesor: desempeño, conducta, incidentes.
model StudentNote {
  id        Int     @id @default(autoincrement())
  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  body      String

  authorId Int?
  author   User? @relation("NotaEscritaPor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
}

// ---------------------------------------------------------------------------
// Invitaciones de inscripción
// ---------------------------------------------------------------------------

enum InvitationKind {
  /// El formulario pide los datos del tutor y los de sus hijos.
  TUTOR
  /// El formulario pide los datos del propio alumno.
  ALUMNO
}

/// Invitación para que un alumno o un tutor se registre él mismo.
///
/// El profesor genera una, comparte el enlace o el QR, y la persona llena el
/// formulario sin necesidad de tener sesión. Al enviarlo queda registrada y
/// ligada al profesor que generó la invitación.
///
/// Es de UN SOLO USO y caduca: el token viaja por WhatsApp o pegado en una
/// pared, así que hay que asumir que puede acabar en manos de cualquiera.
model Invitation {
  id Int @id @default(autoincrement())

  /// Token aleatorio que va en la URL. Lo único que protege el formulario,
  /// así que se genera con 24 bytes de crypto.randomBytes, no con Math.random.
  token String @unique

  kind InvitationKind

  /// Profesor o admin que la generó. El alumno queda asignado a él.
  createdById Int
  createdBy   User @relation("InvitacionCreadaPor", fields: [createdById], references: [id], onDelete: Cascade)

  /// Alumno al que se ligará el tutor, si la invitación es para sumar un
  /// tutor a un expediente que ya existe. Nulo si el tutor va a dar de alta
  /// a sus hijos desde cero.
  studentId Int?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Nota para que el profesor recuerde a quién se la mandó.
  note String?

  expiresAt DateTime

  /// Nulo mientras no se usa. Al usarse se sella y ya no sirve.
  usedAt DateTime?

  /// Qué se creó al usarla. Sirve para rastrear de dónde salió cada cuenta.
  createdUserId    Int?
  createdStudentId Int?

  createdAt DateTime @default(now())

  @@index([createdById])
  @@index([usedAt])
}

// ---------------------------------------------------------------------------
// Notificaciones
// ---------------------------------------------------------------------------

enum NotificationKind {
  /// La generó el sistema cuando pasó algo (mensualidad vencida, graduación).
  AUTOMATICA
  /// La redactó un humano del dojo y la mandó a uno o varios usuarios.
  AVISO
}

enum NotificationTopic {
  PAGO
  GRADUACION
  ASISTENCIA
  EVENTO
  GENERAL
}

model Notification {
  id Int @id @default(autoincrement())

  /// A quién le llega.
  userId Int
  user   User @relation("NotificacionDestinatario", fields: [userId], references: [id], onDelete: Cascade)

  kind  NotificationKind
  topic NotificationTopic @default(GENERAL)
  title String
  body  String

  /// Ruta del frontend a la que lleva al tocarla, p. ej. "/pagos".
  link String?

  /// Nulo mientras no se ha leído. Guardamos la fecha y no un booleano
  /// porque sirve para saber cuánto tardó el usuario en verla.
  readAt DateTime?

  /// Identificador del hecho que la originó, p. ej. "pago-vencido-42".
  ///
  /// Evita que el sistema cree la misma notificación automática una y otra
  /// vez. En Postgres los NULL no colisionan entre sí, así que los avisos
  /// manuales (que van sin clave) no se estorban.
  dedupeKey String?

  /// Quién la redactó, si es un AVISO.
  createdById Int?
  createdBy   User? @relation("NotificacionAutor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Eventos
// ---------------------------------------------------------------------------

enum EventCategory {
  CLASE
  EXAMEN
  TORNEO
  PAGO
}

model Event {
  id       Int           @id @default(autoincrement())
  title    String
  date     DateTime      @db.Date
  /// Hora en formato HH:MM. Nulo significa "todo el día".
  time     String?
  category EventCategory

  /// Si hay que pagar para participar. Un torneo o un examen suelen costar.
  requiresPayment Boolean @default(false)

  /// Costo en CENTAVOS cuando el evento NO tiene modalidades.
  ///
  /// Un examen de cinta cobra una sola cuota y le basta este campo. Un
  /// torneo define modalidades y entonces el costo sale de la suma de las
  /// que elija cada alumno, y este campo se ignora.
  priceCents Int?

  /// Modalidades con su propio costo: kata, kumite, equipos...
  modalities EventModality[]

  createdById Int?
  createdBy   User? @relation("EventoCreadoPor", fields: [createdById], references: [id], onDelete: SetNull)

  enrollments EventEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

/// Una modalidad de un evento, con su costo propio.
///
/// Las define cada evento y no una lista fija del sistema: un torneo tiene
/// kata y kumite, otro puede tener equipos o formas con arma, y agregar una
/// nueva no debería exigir cambiar el código.
model EventModality {
  id Int @id @default(autoincrement())

  eventId Int
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// "Kata", "Kumite", "Equipos"...
  name String

  /// Costo BASE en CENTAVOS, el que fija el administrador.
  ///
  /// Cada profesor puede tener el suyo para sus propios alumnos: ver
  /// TeacherModalityPrice. Si no lo tiene, se cobra este.
  priceCents Int

  createdAt DateTime @default(now())

  enrollments EventEnrollmentModality[]

  /// Precios que fijó cada profesor para sus alumnos.
  teacherPrices TeacherModalityPrice[]

  /// No tiene sentido repetir el nombre dentro del mismo evento.
  @@unique([eventId, name])
}

/// El precio que un profesor cobra por una modalidad a SUS alumnos.
///
/// El administrador fija el precio base del evento; cada profesor puede
/// ajustarlo para su grupo sin afectar a los demás. Un profesor que no
/// ajusta nada cobra el base.
///
/// Qué precio aplica se resuelve con el profesor al que se acredita el
/// cobro, que es quien recibe el dinero.
model TeacherModalityPrice {
  id Int @id @default(autoincrement())

  modalityId Int
  modality   EventModality @relation(fields: [modalityId], references: [id], onDelete: Cascade)

  teacherId Int
  teacher   User @relation("PrecioDeProfesor", fields: [teacherId], references: [id], onDelete: Cascade)

  priceCents Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Un profesor tiene un solo precio por modalidad.
  @@unique([modalityId, teacherId])
  @@index([teacherId])
}

/// Rama de la categoría: femenil o varonil.
enum CompetitionGender {
  FEMENIL
  VARONIL
}

/// Las categorías se dividen por tipo de cinta, y los rangos de edad NO son
/// los mismos en cada rama.
enum BeltClass {
  /// De blanca a marrón.
  COLOR
  /// Cinta negra. Usa la nomenclatura U10, U12, Cadete, Junior, U21...
  NEGRA
}

/// Categoría de edad.
///
/// Reúne las dos tablas en un solo enum porque una inscripción solo puede
/// estar en una. Qué valores son válidos depende de `BeltClass`, y eso se
/// valida en src/lib/competitionCategories.ts, no aquí: Prisma no puede
/// expresar "este enum depende de aquel campo".
///
/// MASTERS existe en las dos ramas con el mismo rango, así que es un solo
/// valor compartido.
enum AgeCategory {
  // --- Cintas de color ---
  INFANTIL_4_5
  INFANTIL_6_7
  INFANTIL_8_9
  INFANTIL_10_11
  INFANTIL_12_13
  JUVENIL_14_15
  JUVENIL_16_17
  ADULTOS_18_35

  // --- Cintas negras ---
  U10_8_9
  U12_10_11
  U14_12_13
  CADETE_14_15
  JUNIOR_16_17
  U21_18_20
  SENIOR_21_35

  // --- Común a las dos ramas ---
  MASTERS_36_MAS
}

enum EventPaymentStatus {
  /// El profesor lo inscribió y todavía no paga.
  ///
  /// Es el punto de partida cuando la inscripción la arma el profesor: el
  /// alumno ya sabe en qué modalidades va y cuánto debe, pero no está
  /// inscrito hasta que el pago se confirme.
  PENDIENTE_PAGO

  /// El alumno dijo que ya pagó. Falta que el profesor lo confirme.
  REPORTADO
  /// El profesor confirmó el pago. Con esto queda inscrito.
  CONFIRMADO
  /// El profesor dijo que no le pagaron.
  RECHAZADO
}

/// Pago e inscripción de un alumno a un evento.
///
/// El flujo es: el profesor comparte su clave, el alumno reporta el pago
/// escribiéndola, y el profesor confirma. Al confirmar, el alumno queda
/// inscrito automáticamente.
model EventEnrollment {
  id Int @id @default(autoincrement())

  eventId Int
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Profesor al que se acredita el cobro, resuelto a partir de la clave que
  /// escribió el alumno. Es lo que hace que el pago aparezca en SU historial.
  ///
  /// SetNull para no perder el registro del pago si el profesor se da de baja.
  creditedToId Int?
  creditedTo   User? @relation("CobroAcreditadoA", fields: [creditedToId], references: [id], onDelete: SetNull)

  /// Monto TOTAL en centavos: la suma de las modalidades elegidas, o el
  /// precio del evento si no tiene modalidades.
  ///
  /// Se congela al reportar, para que cambiar precios después no altere los
  /// cobros ya hechos.
  amountCents Int

  /// Categoría en la que compite: rama, tipo de cinta y rango de edad.
  ///
  /// Los tres van juntos o ninguno. Se ELIGEN al inscribir y la edad PUEDE
  /// no coincidir con el rango, a propósito: hay alumnos a los que se foguea
  /// con una categoría mayor. Por eso no se calculan de la fecha de
  /// nacimiento, solo se sugieren.
  gender      CompetitionGender?
  beltClass   BeltClass?
  ageCategory AgeCategory?

  /// Modalidades a las que entra. Un alumno puede ir a kata y kumite.
  modalities EventEnrollmentModality[]

  status EventPaymentStatus @default(REPORTADO)

  /// Inscrito en el evento. Se pone en true al confirmar el pago.
  enrolled Boolean @default(false)

  method PaymentMethod?
  note   String?

  /// Id de la orden de PayPal, si se pagó en línea. Ver Payment.externalReference.
  externalReference String? @unique

  reportedAt  DateTime  @default(now())
  confirmedAt DateTime?

  confirmedById Int?
  confirmedBy   User? @relation("CobroConfirmadoPor", fields: [confirmedById], references: [id], onDelete: SetNull)

  /// Un alumno no puede reportar dos veces el mismo evento.
  @@unique([eventId, studentId])
  @@index([creditedToId])
  @@index([status])
}

/// Qué modalidades eligió un alumno, con el precio congelado de cada una.
model EventEnrollmentModality {
  id Int @id @default(autoincrement())

  enrollmentId Int
  enrollment   EventEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  modalityId Int
  modality   EventModality @relation(fields: [modalityId], references: [id], onDelete: Cascade)

  /// Precio de esa modalidad cuando se inscribió. Guardarlo aquí permite
  /// reconstruir el desglose del cobro aunque el evento cambie de precio.
  priceCents Int

  @@unique([enrollmentId, modalityId])
}

// ---------------------------------------------------------------------------
// Uniformes y protecciones
// ---------------------------------------------------------------------------

enum EquipmentCategory {
  UNIFORME
  PROTECCION
}

enum EquipmentRequestStatus {
  /// La familia lo pidió. Falta que el profesor confirme disponibilidad y precio.
  SOLICITADO
  /// El profesor confirmó el precio. Ya se puede pagar.
  CONFIRMADO
  /// La familia dijo que pagó en efectivo o transferencia. Falta que lo confirmen.
  REPORTADO
  PAGADO
  ENTREGADO
  RECHAZADO
}

/// Una marca del catálogo, con la dirección de su tienda.
model EquipmentBrand {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  url    String?
  active Boolean @default(true)

  models EquipmentModel[]
}

/// Lo que se puede pedir, sin importar la marca: guantes, casco, uniforme de kata.
model EquipmentProduct {
  id        Int               @id @default(autoincrement())
  name      String            @unique
  category  EquipmentCategory
  sortOrder Int               @default(0)

  /// Cada producto define las suyas: los uniformes van por estatura, las
  /// protecciones por letra y el bucal solo es niño o adulto.
  sizes  String[]
  /// Vacío si el producto no se pide por color.
  colors String[]

  models EquipmentModel[]
  items  EquipmentRequestItem[]
}

/// Una opción concreta: el producto de una marca, con su precio.
model EquipmentModel {
  id Int @id @default(autoincrement())

  productId Int
  product   EquipmentProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  brandId Int
  brand   EquipmentBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  name       String
  priceCents Int
  url        String?
  active     Boolean @default(true)

  /// Verdadero si el modelo y su precio son de muestra y no datos reales.
  isExample Boolean @default(false)

  items EquipmentRequestItem[]

  @@unique([productId, brandId, name])
  @@index([productId])
}

/// Lo que una familia le pide al profesor para un alumno.
model EquipmentRequest {
  id Int @id @default(autoincrement())

  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Quién hizo la solicitud: el alumno o uno de sus tutores.
  requestedById Int?
  requestedBy   User? @relation("SolicitudEquipoHechaPor", fields: [requestedById], references: [id], onDelete: SetNull)

  /// El profesor del alumno al solicitar. Nulo si no tenía: entonces la ve el admin.
  teacherId Int?
  teacher   User? @relation("SolicitudEquipoProfesor", fields: [teacherId], references: [id], onDelete: SetNull)

  status EquipmentRequestStatus @default(SOLICITADO)

  /// Total en centavos. Nulo mientras algún renglón no tenga precio.
  amountCents Int?

  note      String?
  staffNote String?
  method    PaymentMethod?

  /// Id de la orden de PayPal, si se pagó en línea.
  externalReference String? @unique

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
  paidAt      DateTime?
  deliveredAt DateTime?

  items EquipmentRequestItem[]

  @@index([studentId])
  @@index([teacherId])
  @@index([status])
}

/// Un renglón de la solicitud. Copia los nombres y congela el precio, para
/// que cambiar el catálogo después no altere lo que ya se pidió.
model EquipmentRequestItem {
  id Int @id @default(autoincrement())

  requestId Int
  request   EquipmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  productId Int?
  product   EquipmentProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  modelId Int?
  model   EquipmentModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)

  productName String
  /// La marca del catálogo, o la que escribió la familia en "Otra marca".
  brandName   String
  modelName   String?
  size        String
  color       String?

  /// Nulo si es "Otra marca": el precio lo define el profesor.
  priceCents Int?

  @@index([requestId])
}

// ---------------------------------------------------------------------------
// Horario de clases
// ---------------------------------------------------------------------------

enum Discipline {
  KARATE
  JUDO
  TAEKWONDO
  DEFENSA_PERSONAL
  ACONDICIONAMIENTO
}

enum Level {
  PRINCIPIANTES
  INTERMEDIOS
  AVANZADOS
  MIXTO
}

/// Una clase que se repite cada semana.
model DojoClass {
  id         Int        @id @default(autoincrement())
  title      String
  discipline Discipline

  /// 0 = lunes ... 6 = domingo, como en el resto de la app.
  dayOfWeek Int
  /// "16:00". Con ceros a la izquierda, ordenar el texto ordena por hora.
  startTime String
  endTime   String

  location String
  level    Level
  capacity Int

  /// SetNull para que dar de baja a un profesor no borre su lugar en el horario.
  teacherId Int?
  teacher   User? @relation("ClaseDeProfesor", fields: [teacherId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dayOfWeek])
  @@index([teacherId])
}
