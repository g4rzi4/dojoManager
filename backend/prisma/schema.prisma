generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // El backend es CommonJS ("type": "commonjs" en package.json), así que el
  // cliente debe generarse en CJS. Sin esto, Prisma 7 lo genera en ESM y los
  // imports fallan en tiempo de ejecución.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Usuarios y roles
// ---------------------------------------------------------------------------

enum Role {
  /// Dueño del dojo. Único que puede administrar profesores y configuración.
  ADMIN
  /// Subadministrador: alumnos, eventos, pagos y reportes.
  PROFESOR
  /// Solo consulta su propia tarjeta. No edita nada.
  ALUMNO
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  /// Hash de bcrypt, nunca la contraseña en texto plano.
  password  String
  role      Role     @default(ALUMNO)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Expediente, solo si este usuario es un alumno.
  student Student?

  // Rastro de quién hizo cada cosa. Son opcionales y con onDelete: SetNull
  // para que dar de baja a un profesor no borre el historial del alumno.
  promotionsEvaluated BeltPromotion[] @relation("PromocionEvaluadaPor")
  notesWritten        StudentNote[]   @relation("NotaEscritaPor")
  attendanceRecorded  Attendance[]    @relation("AsistenciaRegistradaPor")
  paymentsRegistered  Payment[]       @relation("PagoRegistradoPor")
  eventsCreated       Event[]         @relation("EventoCreadoPor")

  @@index([role])
}

// ---------------------------------------------------------------------------
// Alumnos
// ---------------------------------------------------------------------------

enum Belt {
  BLANCO
  AMARILLO
  NARANJA
  VERDE
  AZUL
  MARRON
  NEGRO
}

/// Expediente del alumno: los datos de su tarjeta de información.
model Student {
  id        Int       @id @default(autoincrement())
  firstName String
  lastName  String
  birthDate DateTime? @db.Date
  phone     String?

  /// Tutor responsable. Obligatorio en la práctica para alumnos menores de
  /// edad, pero el schema no lo exige porque también hay alumnos adultos.
  guardianName  String?
  guardianPhone String?

  /// Padecimientos, alergias o lesiones que el profesor debe conocer.
  medicalNotes String?

  currentBelt Belt     @default(BLANCO)
  enrolledAt  DateTime @default(now())
  /// Baja lógica: preferimos desactivar antes que borrar, para no perder
  /// el historial de pagos y graduaciones.
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Cuenta para que el alumno entre a ver su propia tarjeta. Opcional:
  /// un alumno puede existir en el sistema sin poder iniciar sesión.
  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  promotions BeltPromotion[]
  attendance Attendance[]
  payments   Payment[]
  notes      StudentNote[]

  @@index([lastName, firstName])
  @@index([active])
}

// ---------------------------------------------------------------------------
// Historial del alumno
// ---------------------------------------------------------------------------

/// Cada cambio de cinturón. `Student.currentBelt` es el cinturón vigente;
/// esta tabla guarda cómo llegó hasta ahí.
model BeltPromotion {
  id         Int      @id @default(autoincrement())
  studentId  Int
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  belt       Belt
  promotedAt DateTime @db.Date
  notes      String?

  evaluatedById Int?
  evaluatedBy   User? @relation("PromocionEvaluadaPor", fields: [evaluatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([studentId, promotedAt])
}

model Attendance {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  present   Boolean  @default(true)

  recordedById Int?
  recordedBy   User? @relation("AsistenciaRegistradaPor", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  /// Una sola marca de asistencia por alumno por día: evita duplicados si
  /// alguien registra la misma clase dos veces.
  @@unique([studentId, date])
  @@index([date])
}

enum PaymentStatus {
  PAGADO
  PENDIENTE
  VENCIDO
}

model Payment {
  id        Int     @id @default(autoincrement())
  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Monto en CENTAVOS, como entero. Guardar dinero en float produce errores
  /// de redondeo; usar Decimal complica la serialización a JSON. Para mostrar:
  /// (amountCents / 100).
  amountCents Int

  /// Mes que cubre el pago. Separado de paidAt porque se puede pagar marzo
  /// en abril, y el reporte necesita saber a qué mes corresponde.
  periodYear  Int
  periodMonth Int

  status PaymentStatus @default(PENDIENTE)
  paidAt DateTime?
  note   String?

  registeredById Int?
  registeredBy   User? @relation("PagoRegistradoPor", fields: [registeredById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Un cobro por alumno por mes.
  @@unique([studentId, periodYear, periodMonth])
  @@index([status])
}

/// Observaciones del profesor: desempeño, conducta, incidentes.
model StudentNote {
  id        Int     @id @default(autoincrement())
  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  body      String

  authorId Int?
  author   User? @relation("NotaEscritaPor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
}

// ---------------------------------------------------------------------------
// Eventos
// ---------------------------------------------------------------------------

enum EventCategory {
  CLASE
  EXAMEN
  TORNEO
  PAGO
}

model Event {
  id       Int           @id @default(autoincrement())
  title    String
  date     DateTime      @db.Date
  /// Hora en formato HH:MM. Nulo significa "todo el día".
  time     String?
  category EventCategory

  createdById Int?
  createdBy   User? @relation("EventoCreadoPor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}
