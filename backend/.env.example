# Copia este archivo como .env y rellena tus valores locales:
#   cp .env.example .env
#
# Este archivo SÍ se sube a git. El .env NO (contiene tus credenciales).
# Si tu módulo necesita una variable nueva, agrégala aquí sin el valor real
# y avisa al equipo, para que nadie se quede con un .env incompleto.

# ---------------------------------------------------------------------------
# Base de datos (obligatoria)
# ---------------------------------------------------------------------------

# Opción A: usando el contenedor de docker-compose.yml (recomendado).
DATABASE_URL="postgresql://dojo:dojo@localhost:5432/dojomanager"

# Opción B: usando un PostgreSQL instalado en tu máquina.
# Comenta la línea de arriba, descomenta esta y pon tu usuario del sistema:
# DATABASE_URL="postgresql://TU_USUARIO@localhost:5432/dojomanager"

# ---------------------------------------------------------------------------
# Autenticación (obligatoria)
# ---------------------------------------------------------------------------

# Secreto con el que se firman los tokens de sesión. El backend NO ARRANCA
# sin esta variable.
#
# En local puede ser cualquier cadena larga. En producción tiene que ser un
# valor aleatorio y secreto: quien lo conozca puede falsificar sesiones de
# cualquier usuario, incluido el administrador. Para generar uno:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambiame-por-una-cadena-larga-y-aleatoria-solo-para-desarrollo"

# ---------------------------------------------------------------------------
# Servidor (opcionales, con valores por omisión)
# ---------------------------------------------------------------------------

# Puerto del backend. Si lo cambias, actualiza también la URL en
# frontend/src/services/api.ts.
PORT=3000

# Origen permitido para CORS: la dirección del frontend de Vite.
CORS_ORIGIN="http://localhost:5173"
