# Copia este archivo como .env y rellena tus valores locales:
#   cp .env.example .env
#
# Cada persona del equipo usa su propio usuario de PostgreSQL local.
# Este archivo SÍ se sube a git. El .env NO.

# Conexión a PostgreSQL. Reemplaza TU_USUARIO por tu usuario del sistema.
DATABASE_URL="postgresql://TU_USUARIO@localhost:5432/dojomanager"

# Puerto del servidor Express
PORT=3000

# Secreto para firmar los JWT de autenticación.
# En local puede ser cualquier cadena larga; en producción debe ser un valor aleatorio y secreto.
JWT_SECRET="cambiame-por-una-cadena-larga-y-aleatoria"

# Origen permitido para CORS (el frontend de Vite)
CORS_ORIGIN="http://localhost:5173"
